---
import { Icon } from 'astro-icon/components';
import type { Language } from '../i18n/ui';
import { useTranslation } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslation(lang);

const workflowPillars = [
  {
    icon: 'heroicons:magnifying-glass-circle',
    title: t('workflow.1.title'),
    desc: t('workflow.1.desc'),
    meta: t('workflow.1.meta'),
  },
  {
    icon: 'heroicons:document-text',
    title: t('workflow.2.title'),
    desc: t('workflow.2.desc'),
    meta: t('workflow.2.meta'),
  },
  {
    icon: 'heroicons:arrows-right-left',
    title: t('workflow.3.title'),
    desc: t('workflow.3.desc'),
    meta: t('workflow.3.meta'),
  },
];

const featureGroups = [
  {
    groupTitle: t('features.group.find'),
    items: [
      { icon: 'heroicons:document-duplicate', title: t('features.snapshots.title'), desc: t('features.snapshots.desc') },
      { icon: 'heroicons:magnifying-glass', title: t('features.semantic-search.title'), desc: t('features.semantic-search.desc') },
      { icon: 'heroicons:document-text', title: t('features.ai-summary.title'), desc: t('features.ai-summary.desc') },
      { icon: 'heroicons:tag', title: t('features.ai-tags.title'), desc: t('features.ai-tags.desc') },
    ],
  },
  {
    groupTitle: t('features.group.organize'),
    items: [
      { icon: 'heroicons:folder-plus', title: t('features.ai-classify.title'), desc: t('features.ai-classify.desc') },
      { icon: 'heroicons:squares-2x2', title: t('features.ai-organize.title'), desc: t('features.ai-organize.desc') },
      { icon: 'heroicons:arrows-right-left', title: t('features.diff-view.title'), desc: t('features.diff-view.desc') },
      { icon: 'heroicons:command-line', title: t('features.commander.title'), desc: t('features.commander.desc') },
    ],
  },
  {
    groupTitle: t('features.group.control'),
    items: [
      { icon: 'heroicons:shield-check', title: t('features.health-check.title'), desc: t('features.health-check.desc') },
      { icon: 'heroicons:arrow-uturn-left', title: t('features.undo-redo.title'), desc: t('features.undo-redo.desc') },
      { icon: 'heroicons:bolt', title: t('features.auto-process.title'), desc: t('features.auto-process.desc') },
      { icon: 'heroicons:lock-closed', title: t('features.privacy.title'), desc: t('features.privacy.desc') },
    ],
  },
];
---

<!-- Band 1: Three Core Mechanisms (Airy White Studio Section) -->
<section id="workflow" class="py-16 sm:py-24 bg-studio-surface border-y border-studio-border">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-12">
      <h2 class="text-2xl sm:text-4xl font-semibold tracking-[-0.03em] text-studio-ink mb-3">
        {t('workflow.title')}
      </h2>
      <p class="text-base text-studio-ink-soft leading-relaxed">
        {t('workflow.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {workflowPillars.map((pillar) => (
        <div class="p-6 rounded-2xl bg-studio-surface-subtle border border-studio-border flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-studio-surface border border-studio-border flex items-center justify-center mb-5 shadow-2xs">
              <Icon name={pillar.icon} class="w-5 h-5 text-brand-indigo" />
            </div>
            <h3 class="text-lg font-semibold tracking-[-0.02em] text-studio-ink leading-snug mb-2.5">
              {pillar.title}
            </h3>
            <p class="text-sm text-studio-ink-soft leading-relaxed mb-6">
              {pillar.desc}
            </p>
          </div>
          <div class="pt-4 border-t border-studio-border">
            <span class="font-mono text-[11px] text-studio-ink-muted">
              {pillar.meta}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Band 2: Capability Bento + Deep Brand Indigo Agent Callout -->
<section id="features" class="py-16 sm:py-24 bg-studio-bg">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-12">
      <h2 class="text-2xl sm:text-4xl font-semibold tracking-[-0.03em] text-studio-ink mb-3">
        {t('features.title')}
      </h2>
      <p class="text-base text-studio-ink-soft leading-relaxed">
        {t('features.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {featureGroups.map((group) => (
        <div class="studio-card p-6 sm:p-7 flex flex-col">
          <h3 class="text-base font-semibold tracking-[-0.015em] text-studio-ink pb-3.5 mb-5 border-b border-studio-border">
            {group.groupTitle}
          </h3>
          <ul class="space-y-5 flex-1">
            {group.items.map((item) => (
              <li class="flex items-start gap-3">
                <div class="w-7 h-7 rounded-lg bg-studio-bg flex items-center justify-center shrink-0 mt-0.5">
                  <Icon name={item.icon} class="w-4 h-4 text-brand-cobalt" />
                </div>
                <div>
                  <h4 class="text-sm font-semibold text-studio-ink mb-0.5">
                    {item.title}
                  </h4>
                  <p class="text-xs sm:text-[13px] text-studio-ink-soft leading-relaxed">
                    {item.desc}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Brand-harmonized Deep Indigo Optional Agent Bridge Callout (#182242 / #89AEFA matching logo) -->
    <div class="mt-8 rounded-2xl bg-[#192444] text-white p-6 sm:p-8 border border-[#2C3B69] shadow-[0_20px_50px_-15px_rgba(25,36,68,0.35)]">
      <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-5 mb-6">
        <div class="max-w-2xl">
          <div class="flex items-center gap-2.5 mb-2">
            <Icon name="heroicons:cpu-chip" class="w-5 h-5 text-brand-ice shrink-0" />
            <h3 class="text-lg sm:text-xl font-semibold tracking-[-0.02em] text-white">
              {t('bridge.title')}
            </h3>
          </div>
          <p class="text-sm text-[#C8D4EE] leading-relaxed">
            {t('bridge.desc')}
          </p>
        </div>
        <div class="flex flex-wrap lg:justify-end gap-2 shrink-0">
          <span class="px-3 py-1 rounded-full bg-white/10 border border-white/15 text-xs font-mono text-white">
            {t('bridge.badge1')}
          </span>
          <span class="px-3 py-1 rounded-full bg-[#89AEFA]/20 border border-[#89AEFA]/35 text-xs font-medium text-[#CFE0FF]">
            {t('bridge.badge2')}
          </span>
          <span class="px-3 py-1 rounded-full bg-white/10 border border-white/15 text-xs font-mono text-[#D5E0F5]">
            {t('bridge.badge3')}
          </span>
          <span class="px-3 py-1 rounded-full bg-white/10 border border-white/15 text-xs font-medium text-[#D5E0F5]">
            {t('bridge.badge4')}
          </span>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="rounded-xl bg-white/[0.06] border border-white/10 p-4 sm:p-5">
          <h4 class="text-sm font-semibold text-white mb-1.5">
            {t('bridge.wayA.title')}
          </h4>
          <p class="text-xs sm:text-[13px] text-[#C8D4EE] leading-relaxed">
            {t('bridge.wayA.desc')}
          </p>
        </div>
        <div class="rounded-xl bg-white/[0.06] border border-white/10 p-4 sm:p-5">
          <h4 class="text-sm font-semibold text-white mb-1.5">
            {t('bridge.wayB.title')}
          </h4>
          <p class="text-xs sm:text-[13px] text-[#C8D4EE] leading-relaxed">
            {t('bridge.wayB.desc')}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
