---
import { Icon } from 'astro-icon/components';
import type { Language } from '../i18n/ui';
import { useTranslation, getLocalizedPath, getLanguageList } from '../i18n/utils';
import { languages } from '../i18n/ui';
import { config } from '../config';

interface Props {
  lang: Language;
  currentPath?: string;
}

const { lang, currentPath = '/' } = Astro.props;
const t = useTranslation(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const allLanguages = getLanguageList();

const navLinks = [
  { href: getLocalizedPath(lang, '/'), path: '/', label: t('nav.home') },
  { href: getLocalizedPath(lang, '/get-started/'), path: '/get-started/', label: t('nav.getStarted') },
  { href: getLocalizedPath(lang, '/privacy/'), path: '/privacy/', label: t('nav.privacy') },
  { href: getLocalizedPath(lang, '/donate/'), path: '/donate/', label: t('nav.donate') },
];

const isCurrent = (linkPath: string) => currentPath === linkPath;
---

<header id="top-header" class="sticky top-0 z-50 transition-all duration-200 border-b border-transparent">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Brand mark -->
      <a
        href={`${base}${getLocalizedPath(lang, '/')}`}
        class="flex items-center gap-2.5 group"
      >
        <img
          src={`${base}/logo.png`}
          alt="MarkShelf"
          width="30"
          height="30"
          class="w-[30px] h-[30px] rounded-[8px] shadow-xs transition-transform duration-200 group-hover:scale-105"
        />
        <span class="text-[15px] font-semibold tracking-[-0.02em] text-studio-ink">
          MarkShelf
        </span>
      </a>

      <!-- Desktop Minimal Navigation -->
      <nav aria-label={t('nav.aria.primary')} class="hidden md:flex items-center gap-1">
        {navLinks.map((link) => (
          <a
            href={`${base}${link.href}`}
            aria-current={isCurrent(link.path) ? 'page' : undefined}
            class:list={[
              'px-3 py-1.5 rounded-full text-[13px] font-medium transition-colors',
              isCurrent(link.path)
                ? 'text-studio-ink bg-black/[0.05]'
                : 'text-studio-ink-soft hover:text-studio-ink hover:bg-black/[0.03]',
            ]}
          >
            {link.label}
          </a>
        ))}

        <div class="w-px h-4 bg-studio-border-strong mx-2"></div>

        <!-- Desktop Language Switcher Dropdown -->
        <div class="relative lang-dropdown-container">
          <button
            type="button"
            id="lang-menu-btn"
            class="px-2.5 py-1.5 rounded-full text-[13px] font-medium text-studio-ink-soft hover:text-studio-ink hover:bg-black/[0.04] transition-colors inline-flex items-center gap-1.5 cursor-pointer"
            aria-expanded="false"
            aria-haspopup="true"
            aria-label="Language selection"
          >
            <Icon name="heroicons:language" class="w-4 h-4 text-studio-ink-muted" />
            <span>{languages[lang]}</span>
            <Icon name="heroicons:chevron-down" class="w-3.5 h-3.5 text-studio-ink-muted" />
          </button>

          <div
            id="lang-dropdown-menu"
            class="hidden absolute right-0 mt-1.5 w-36 py-1.5 bg-studio-surface border border-studio-border rounded-xl shadow-lg z-50 text-xs font-medium"
            role="menu"
          >
            {allLanguages.map((item) => (
              <a
                href={`${base}${getLocalizedPath(item.code, currentPath)}`}
                role="menuitem"
                class:list={[
                  'flex items-center justify-between px-3.5 py-2 hover:bg-studio-surface-subtle transition-colors',
                  item.code === lang
                    ? 'text-brand-cobalt font-semibold bg-brand-cobalt/[0.04]'
                    : 'text-studio-ink-soft hover:text-studio-ink',
                ]}
              >
                <span>{item.label}</span>
                {item.code === lang && <Icon name="heroicons:check" class="w-3.5 h-3.5 text-brand-cobalt" />}
              </a>
            ))}
          </div>
        </div>

        <a
          href={config.stores.chrome}
          target="_blank"
          rel="noopener noreferrer"
          class="ml-2 btn-primary px-4 py-1.5 rounded-full text-[13px] font-medium inline-flex items-center gap-1.5"
        >
          <span>{t('hero.cta.chrome')}</span>
        </a>
      </nav>

      <!-- Mobile Controls -->
      <div class="md:hidden flex items-center gap-2">
        <!-- Quick Language Menu in Mobile Top Bar -->
        <div class="relative">
          <button
            type="button"
            id="mobile-lang-btn"
            class="px-2.5 py-1 rounded-full text-xs font-medium text-studio-ink-soft bg-studio-surface border border-studio-border flex items-center gap-1 cursor-pointer"
            aria-label="Change language"
          >
            <span>{languages[lang]}</span>
            <Icon name="heroicons:chevron-down" class="w-3 h-3 text-studio-ink-muted" />
          </button>
          <div
            id="mobile-lang-menu"
            class="hidden absolute right-0 mt-1.5 w-36 py-1 bg-studio-surface border border-studio-border rounded-xl shadow-lg z-50 text-xs font-medium"
          >
            {allLanguages.map((item) => (
              <a
                href={`${base}${getLocalizedPath(item.code, currentPath)}`}
                class:list={[
                  'flex items-center justify-between px-3.5 py-2 hover:bg-studio-surface-subtle transition-colors',
                  item.code === lang
                    ? 'text-brand-cobalt font-semibold bg-brand-cobalt/[0.04]'
                    : 'text-studio-ink-soft hover:text-studio-ink',
                ]}
              >
                <span>{item.label}</span>
                {item.code === lang && <Icon name="heroicons:check" class="w-3.5 h-3.5 text-brand-cobalt" />}
              </a>
            ))}
          </div>
        </div>

        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2 rounded-full bg-studio-surface border border-studio-border text-studio-ink cursor-pointer"
          aria-label={t('nav.aria.toggle')}
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Icon id="menu-icon" name="heroicons:bars-3" class="w-5 h-5" />
          <Icon id="close-icon" name="heroicons:x-mark" class="w-5 h-5 hidden" />
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-studio-border bg-studio-surface/95 backdrop-blur-md">
    <nav aria-label={t('nav.aria.mobile')} class="max-w-6xl mx-auto px-4 py-3 flex flex-col gap-1">
      {navLinks.map((link) => (
        <a
          href={`${base}${link.href}`}
          aria-current={isCurrent(link.path) ? 'page' : undefined}
          class:list={[
            'px-3.5 py-2.5 rounded-xl text-sm font-medium transition-colors',
            isCurrent(link.path)
              ? 'bg-studio-bg text-studio-ink font-semibold'
              : 'text-studio-ink-soft hover:text-studio-ink hover:bg-studio-bg/60',
          ]}
        >
          {link.label}
        </a>
      ))}

      <!-- Mobile Languages Grid -->
      <div class="pt-3 pb-1 border-t border-studio-border mt-2">
        <div class="px-1 text-[11px] font-mono text-studio-ink-muted uppercase tracking-wider mb-2">
          Language / 言語 / Язык / Sprache / Idioma / Langue
        </div>
        <div class="grid grid-cols-2 gap-1.5">
          {allLanguages.map((item) => (
            <a
              href={`${base}${getLocalizedPath(item.code, currentPath)}`}
              class:list={[
                'px-2.5 py-1.5 rounded-lg text-xs font-medium border text-center transition-colors',
                item.code === lang
                  ? 'bg-studio-surface border-brand-cobalt text-brand-cobalt font-semibold'
                  : 'bg-studio-surface-subtle border-studio-border text-studio-ink-soft hover:text-studio-ink',
              ]}
            >
              {item.label}
            </a>
          ))}
        </div>
      </div>

      <a
        href={config.stores.chrome}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 btn-primary px-4 py-2.5 rounded-xl text-sm font-medium text-center"
      >
        {t('hero.cta.chrome')}
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('top-header');
  const syncHeader = () => {
    const scrolled = window.scrollY > 12;
    header?.classList.toggle('bg-studio-bg/85', scrolled);
    header?.classList.toggle('backdrop-blur-md', scrolled);
    header?.classList.toggle('border-studio-border', scrolled);
    header?.classList.toggle('border-transparent', !scrolled);
  };
  window.addEventListener('scroll', syncHeader, { passive: true });
  syncHeader();

  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isOpen));
  });

  // Desktop Dropdown
  const langBtn = document.getElementById('lang-menu-btn');
  const langMenu = document.getElementById('lang-dropdown-menu');

  langBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isHidden = langMenu?.classList.contains('hidden');
    langMenu?.classList.toggle('hidden');
    langBtn.setAttribute('aria-expanded', String(isHidden));
  });

  // Mobile Top Bar Dropdown
  const mobileLangBtn = document.getElementById('mobile-lang-btn');
  const mobileLangMenu = document.getElementById('mobile-lang-menu');

  mobileLangBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    mobileLangMenu?.classList.toggle('hidden');
  });

  // Click Outside to Dismiss
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (langMenu && !langMenu.classList.contains('hidden') && !target?.closest('.lang-dropdown-container')) {
      langMenu.classList.add('hidden');
      langBtn?.setAttribute('aria-expanded', 'false');
    }
    if (mobileLangMenu && !mobileLangMenu.classList.contains('hidden') && !target?.closest('#mobile-lang-btn')) {
      mobileLangMenu.classList.add('hidden');
    }
  });
</script>
