---
import { Icon } from 'astro-icon/components';
import type { Language } from '../i18n/ui';
import { useTranslation, getLocalizedPath } from '../i18n/utils';
import { config } from '../config';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslation(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const sampleCards = lang === 'zh'
  ? [
      {
        id: 'card-1',
        title: 'Local-First Software: You Own Your Data',
        domain: 'inkandswitch.com',
        folder: '研究 / 本地优先架构',
        tags: ['local-first', 'offline-sync'],
        excerpt: '基于 IndexedDB 与本地快照实现毫秒级检索，离线状态下依然可用。',
        searchBlob: 'local-first software indexeddb offline sync data ownership crdt 本地 离线 快照',
        badge: t('drawer.matchSnapshot'),
        badgeTone: 'emerald',
      },
      {
        id: 'card-2',
        title: 'Butterick’s Practical Typography',
        domain: 'practicaltypography.com',
        folder: '设计 / 排版规范',
        tags: ['排版', 'typography'],
        excerpt: '正文行宽控制在 65 字符左右，配合克制的字重对比保证长文阅读体验。',
        searchBlob: 'practical typography layout reading measure 排版 字体 行距 设计',
        badge: t('drawer.matchTitle'),
        badgeTone: 'indigo',
      },
      {
        id: 'card-3',
        title: 'Model Context Protocol Specification',
        domain: 'modelcontextprotocol.io',
        folder: '开发 / Agent 工具',
        tags: ['agent', 'mcp'],
        excerpt: '通过本地 Stdio MCP 暴露结构化工具，所有写入请求均需先过人工 Diff 审核。',
        searchBlob: 'model context protocol agent mcp tools local bridge diff 协议',
        badge: t('drawer.matchSemantic'),
        badgeTone: 'amber',
      },
      {
        id: 'card-4',
        title: 'The Rust Performance Book',
        domain: 'nnethercote.github.io',
        folder: '开发 / 系统性能',
        tags: ['rust', 'profiling'],
        excerpt: '减少热路径上的堆分配与克隆开销，重构前先用火焰图定位真实瓶颈。',
        searchBlob: 'rust performance profiling memory allocation 系统编程 性能',
        badge: t('drawer.matchSnapshot'),
        badgeTone: 'emerald',
      },
    ]
  : [
      {
        id: 'card-1',
        title: 'Local-First Software: You Own Your Data',
        domain: 'inkandswitch.com',
        folder: 'Research / Local-First',
        tags: ['local-first', 'offline-sync'],
        excerpt: 'Keep full-text snapshots inside IndexedDB so search stays instant offline with zero cloud lock-in.',
        searchBlob: 'local-first software indexeddb offline sync data ownership crdt',
        badge: t('drawer.matchSnapshot'),
        badgeTone: 'emerald',
      },
      {
        id: 'card-2',
        title: 'Butterick’s Practical Typography',
        domain: 'practicaltypography.com',
        folder: 'Design / Typography',
        tags: ['typography', 'layout'],
        excerpt: 'Keep body measure near 65 characters and pair steady line spacing with restrained type contrast.',
        searchBlob: 'practical typography layout reading measure design fonts',
        badge: t('drawer.matchTitle'),
        badgeTone: 'indigo',
      },
      {
        id: 'card-3',
        title: 'Model Context Protocol Specification',
        domain: 'modelcontextprotocol.io',
        folder: 'Dev / AI Tooling',
        tags: ['agent', 'mcp'],
        excerpt: 'Connect local agents over Stdio MCP while routing every write through human Diff review.',
        searchBlob: 'model context protocol agent mcp tools local bridge diff',
        badge: t('drawer.matchSemantic'),
        badgeTone: 'amber',
      },
      {
        id: 'card-4',
        title: 'The Rust Performance Book',
        domain: 'nnethercote.github.io',
        folder: 'Dev / Systems',
        tags: ['rust', 'profiling'],
        excerpt: 'Avoid unnecessary heap allocations on hot paths and profile with flamegraphs before refactoring.',
        searchBlob: 'rust performance profiling memory allocation systems',
        badge: t('drawer.matchSnapshot'),
        badgeTone: 'emerald',
      },
    ];

const sampleDiffs = lang === 'zh'
  ? [
      {
        id: 'diff-1',
        title: 'Local-First Software: You Own Your Data',
        from: '书签栏 / 临时阅读',
        to: '研究 / 本地优先架构',
        addedTag: '+local-first',
      },
      {
        id: 'diff-2',
        title: 'Butterick’s Practical Typography',
        from: '未分类收藏',
        to: '设计 / 排版规范',
        addedTag: '+typography',
      },
      {
        id: 'diff-3',
        title: 'The Rust Performance Book',
        from: '书签栏 / 稍后看',
        to: '开发 / 系统性能',
        addedTag: '+rust',
      },
    ]
  : [
      {
        id: 'diff-1',
        title: 'Local-First Software: You Own Your Data',
        from: 'Bookmarks Bar / Unsorted',
        to: 'Research / Local-First',
        addedTag: '+local-first',
      },
      {
        id: 'diff-2',
        title: 'Butterick’s Practical Typography',
        from: 'Other Bookmarks',
        to: 'Design / Typography',
        addedTag: '+typography',
      },
      {
        id: 'diff-3',
        title: 'The Rust Performance Book',
        from: 'Bookmarks Bar / Later',
        to: 'Dev / Systems',
        addedTag: '+rust',
      },
    ];
---

    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-12">
      <div class="inline-flex justify-center mb-5">
        <img
          src={`${base}/logo.png`}
          alt="MarkShelf"
          width="60"
          height="60"
          class="w-[60px] h-[60px] rounded-[16px] shadow-[0_10px_28px_-6px_rgba(37,52,95,0.28)]"
        />
      </div>

      <h1
        class:list={[
          'text-3xl sm:text-5xl font-semibold tracking-[-0.035em] leading-[1.15] text-studio-ink mb-4',
          lang === 'en' && 'text-balance',
        ]}
      >
        {t('hero.title')}
      </h1>

      <p class="text-base sm:text-[1.0625rem] text-studio-ink-soft leading-relaxed max-w-[58ch] mx-auto mb-7">
        {t('hero.subtitle')}
      </p>

      <!-- Clean Dual Browser Pill CTAs -->
      <div class="flex flex-wrap items-center justify-center gap-3 mb-4">
        <a
          href={config.stores.chrome}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary inline-flex items-center gap-2.5 px-6 py-3 rounded-full text-sm font-semibold"
        >
          <Icon name="simple-icons:googlechrome" class="w-4 h-4" />
          <span>{t('hero.cta.chrome')}</span>
        </a>

        <a
          href={config.stores.firefox}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary inline-flex items-center gap-2.5 px-5 py-3 rounded-full text-sm font-semibold"
        >
          <Icon name="simple-icons:firefox" class="w-4 h-4 text-[#E66000]" />
          <span>{t('hero.cta.firefox')}</span>
        </a>

        <a
          href={`${base}${getLocalizedPath(lang, '/get-started/')}`}
          class="inline-flex items-center gap-1 px-3 py-2 text-sm font-medium text-studio-ink-soft hover:text-studio-ink transition-colors"
        >
          <span>{t('hero.cta.allBrowsers')}</span>
          <Icon name="heroicons:arrow-right" class="w-3.5 h-3.5" />
        </a>
      </div>

      <p class="text-xs text-studio-ink-muted leading-relaxed">
        {t('hero.trust.local')} · {t('hero.trust.newtab')} · {t('hero.trust.byo')}
      </p>
    </div>

    <!-- Centered Floating Interactive Workbench Window (Oil Git & Sora inspired) -->
    <div class="product-stage max-w-4xl mx-auto">
      <div id="stage-window" class="studio-window product-breath overflow-hidden relative">
        <!-- Window Header Bar -->
        <div class="px-4 sm:px-5 py-3 bg-studio-surface-subtle border-b border-studio-border flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="hidden sm:flex items-center gap-1.5" aria-hidden="true">
            <span class="w-2.5 h-2.5 rounded-full bg-[#E2E7F0]"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#E2E7F0]"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#E2E7F0]"></span>
          </div>

          <div class="seg-pill inline-flex items-center" role="tablist" aria-label={t('drawer.badge')}>
            <button
              type="button"
              role="tab"
              id="tab-search"
              aria-selected="true"
              aria-controls="panel-search"
              class="drawer-tab seg-btn is-active px-3.5 py-1 text-xs font-semibold whitespace-nowrap cursor-pointer"
              data-tab="search"
            >
              {t('drawer.tab.search')}
            </button>
            <button
              type="button"
              role="tab"
              id="tab-diff"
              aria-selected="false"
              aria-controls="panel-diff"
              class="drawer-tab seg-btn px-3.5 py-1 text-xs font-medium text-studio-ink-soft hover:text-studio-ink whitespace-nowrap cursor-pointer"
              data-tab="diff"
            >
              {t('drawer.tab.diff')}
            </button>
          </div>
        </div>

          <!-- Sora-style live indicator -->
          <div class="flex items-center gap-2">
            <span class="dot-live" aria-hidden="true"></span>
            <span class="font-mono text-[11px] text-studio-ink-soft">
              {t('hero.engine.ready')}
            </span>
          </div>
      </div>

      <!-- Mobile touch swipe hint (Sora style) -->
      <div class="sm:hidden px-4 py-1.5 bg-studio-surface-subtle border-b border-studio-border text-[11px] text-studio-ink-muted flex items-center justify-between font-mono">
        <span>←</span>
        <span>{t('hero.swipe.hint')}</span>
        <span>→</span>
      </div>

      <!-- Panel 1: Instant Popup Search + Snapshot Excerpts -->
      <div id="panel-search" role="tabpanel" aria-labelledby="tab-search">
        <div class="px-4 sm:px-5 py-3.5 border-b border-studio-border flex flex-col sm:flex-row sm:items-center gap-3">
          <div class="relative flex-1">
            <Icon
              name="heroicons:magnifying-glass"
              class="w-4 h-4 text-studio-ink-muted absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"
            />
            <input
              id="catalog-search-input"
              type="search"
              placeholder={t('drawer.searchPlaceholder')}
              aria-label={t('drawer.searchPlaceholder')}
              class="w-full pl-9 pr-3 py-1.5 rounded-lg bg-studio-surface-subtle border border-studio-border text-base sm:text-sm text-studio-ink placeholder:text-studio-ink-muted focus:bg-studio-surface focus:border-brand-cobalt"
            />
          </div>

          <div class="flex flex-wrap items-center gap-1.5">
            {[
              { query: '', label: t('drawer.query.all') },
              { query: 'offline sync', label: t('drawer.query.offline') },
              { query: lang === 'zh' ? '排版' : 'typography', label: t('drawer.query.design') },
              { query: 'agent', label: t('drawer.query.diff') },
            ].map((chip, idx) => (
              <button
                type="button"
                data-quick-query={chip.query}
                class:list={[
                  'quick-chip px-2.5 py-1 rounded-full text-xs font-medium transition-colors cursor-pointer whitespace-nowrap',
                  idx === 0
                    ? 'bg-brand-indigo text-white'
                    : 'bg-studio-bg text-studio-ink-soft hover:text-studio-ink hover:bg-studio-bg-deep',
                ]}
              >
                {chip.label}
              </button>
            ))}
          </div>
        </div>

        <div id="catalog-cards-list" class="divide-y divide-studio-border">
          {sampleCards.map((card) => (
            <article
              class="catalog-sample-card px-4 sm:px-5 py-3.5 hover:bg-studio-surface-subtle transition-colors cursor-pointer"
              tabindex="0"
              role="button"
              aria-label={card.title}
              data-id={card.id}
              data-title={card.title}
              data-domain={card.domain}
              data-folder={card.folder}
              data-tags={JSON.stringify(card.tags)}
              data-excerpt={card.excerpt}
              data-search={card.searchBlob.toLowerCase()}
            >
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-x-2 gap-y-1 mb-0.5">
                    <h2 class="text-sm font-semibold text-studio-ink">{card.title}</h2>
                    <span class="font-mono text-[11px] text-studio-ink-muted">{card.domain}</span>
                  </div>
                  <p class="text-xs sm:text-[13px] text-studio-ink-soft leading-relaxed">
                    {card.excerpt}
                  </p>
                </div>

                <div class="shrink-0 flex flex-col items-end gap-1.5">
                  <span
                    class:list={[
                      'px-2 py-0.5 rounded-full text-[11px] font-medium whitespace-nowrap',
                      card.badgeTone === 'emerald'
                        ? 'bg-[#ECFDF3] text-brand-emerald'
                        : card.badgeTone === 'indigo'
                          ? 'bg-[#EEF3FF] text-brand-cobalt'
                          : 'bg-[#FFF3EC] text-[#93370D]',
                    ]}
                  >
                    {card.badge}
                  </span>
                  <span class="hidden sm:inline font-mono text-[11px] text-studio-ink-muted">
                    {card.folder}
                  </span>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div id="catalog-empty-state" class="hidden px-5 py-10 text-center text-sm text-studio-ink-soft">
          {t('drawer.empty')}
        </div>

        <!-- Subtle keyboard footer (Minutes style) -->
        <div class="px-4 sm:px-5 py-2.5 bg-studio-surface-subtle border-t border-studio-border flex flex-wrap items-center justify-between gap-2 text-[11px] text-studio-ink-muted">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-emerald"></span>
            <span class="tabular-nums font-mono">{t('hero.engine.indexed')}</span>
          </div>
          <div class="flex items-center gap-2 sm:gap-2.5 text-[11px]">
            <span class="inline-flex items-center gap-1 font-mono">
              <kbd class="px-1.5 py-0.5 rounded bg-studio-surface border border-studio-border text-studio-ink font-semibold text-[11px]">⌘ / Ctrl K</kbd>
              <span>{t('hero.shortcuts.search')}</span>
            </span>
            <span class="inline-flex items-center gap-1 font-mono">
              <kbd class="px-1.5 py-0.5 rounded bg-studio-surface border border-studio-border text-studio-ink font-semibold text-[11px]">↑ ↓</kbd>
              <span>{t('hero.shortcuts.navigate')}</span>
            </span>
            <span class="inline-flex items-center gap-1 font-mono">
              <kbd class="px-1.5 py-0.5 rounded bg-studio-surface border border-studio-border text-studio-ink font-semibold text-[11px]">Enter</kbd>
              <span>{t('hero.shortcuts.preview')}</span>
            </span>
            <span class="hidden sm:inline-flex items-center gap-1 font-mono">
              <kbd class="px-1.5 py-0.5 rounded bg-studio-surface border border-studio-border text-studio-ink font-semibold text-[11px]">Tab</kbd>
              <span>{t('hero.shortcuts.diff')}</span>
            </span>
            <span class="hidden sm:inline-flex items-center gap-1 font-mono">
              <kbd class="px-1.5 py-0.5 rounded bg-studio-surface border border-studio-border text-studio-ink font-semibold text-[11px]">Esc</kbd>
              <span>{t('hero.shortcuts.clear')}</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Panel 2: Side-by-Side Diff Review -->
      <div id="panel-diff" role="tabpanel" aria-labelledby="tab-diff" class="hidden p-4 sm:p-5">
        <div class="flex flex-wrap items-center justify-between gap-3 pb-3.5 mb-3.5 border-b border-studio-border">
          <div>
            <p class="text-sm font-semibold text-studio-ink">{t('drawer.diffHeader')}</p>
            <p class="font-mono text-xs text-studio-ink-muted">{t('drawer.diffOrigin')}</p>
          </div>
          <span
            id="diff-status-pill"
            class="hidden px-2.5 py-1 rounded-full text-xs font-medium bg-[#ECFDF3] text-brand-emerald"
          >
            {t('drawer.diffApproved')}
          </span>
        </div>

        <div class="space-y-2.5 mb-4">
          {sampleDiffs.map((item) => (
            <label class="flex items-start gap-3 p-3 rounded-xl border border-studio-border bg-studio-surface-subtle hover:border-studio-border-strong transition-colors cursor-pointer">
              <input
                type="checkbox"
                checked
                class="diff-checkbox mt-1 h-4 w-4 rounded accent-[#25345F]"
              />
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between gap-2 mb-1.5">
                  <span class="text-sm font-medium text-studio-ink truncate">{item.title}</span>
                  <span class="px-2 py-0.5 rounded-full text-[11px] font-mono bg-[#FFF3EC] text-[#93370D] shrink-0">
                    {item.addedTag}
                  </span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono">
                  <div class="px-2.5 py-1.5 rounded-lg bg-studio-surface border border-studio-border text-studio-ink-muted truncate">
                    <span class="opacity-70">− </span>{item.from}
                  </div>
                  <div class="px-2.5 py-1.5 rounded-lg bg-[#ECFDF3] border border-[#BBF7D0] text-brand-emerald truncate font-medium">
                    <span>+ </span>{item.to}
                  </div>
                </div>
              </div>
            </label>
          ))}
        </div>

        <div class="flex items-center justify-between gap-3 pt-3.5 border-t border-studio-border">
          <button
            type="button"
            id="diff-approve-btn"
            class="btn-primary px-4 py-2 rounded-full text-xs sm:text-sm font-semibold cursor-pointer tabular-nums"
          >
            {t('drawer.diffApprove')}
          </button>
          <button
            type="button"
            id="diff-undo-btn"
            class="hidden btn-secondary px-4 py-2 rounded-full text-xs sm:text-sm font-medium cursor-pointer"
          >
            {t('drawer.diffUndo')}
          </button>
        </div>
      </div>

        <!-- Snapshot Inspector Modal Drawer -->
        <div
          id="snapshot-drawer"
          class="hidden absolute inset-0 z-30 bg-studio-surface flex flex-col justify-between overflow-y-auto"
          role="dialog"
          aria-modal="true"
          aria-labelledby="drawer-card-title"
        >
          <div class="p-5 sm:p-6">
            <div class="flex items-center justify-between gap-3 mb-4 pb-3 border-b border-studio-border">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-brand-emerald"></span>
                <span class="font-mono text-xs text-brand-emerald font-semibold uppercase tracking-wider">
                  {t('hero.drawer.captured')}
                </span>
                <span class="text-xs text-studio-ink-muted">·</span>
                <span id="drawer-card-domain" class="font-mono text-xs text-studio-ink-muted"></span>
              </div>
              <button
                type="button"
                id="drawer-close-btn"
                class="px-2.5 py-1 rounded-lg border border-studio-border bg-studio-surface-subtle hover:bg-studio-bg text-studio-ink text-xs font-mono font-medium flex items-center gap-1 cursor-pointer transition-colors"
                aria-label={t('hero.drawer.close')}
              >
                <span>Esc</span>
                <span class="text-studio-ink-muted">{t('hero.drawer.close')}</span>
              </button>
            </div>

            <h3 id="drawer-card-title" class="text-lg sm:text-xl font-semibold tracking-[-0.02em] text-studio-ink mb-2.5"></h3>
            
            <div class="flex flex-wrap items-center gap-2 mb-4">
              <span id="drawer-card-folder" class="font-mono text-xs text-studio-ink-muted bg-studio-surface-subtle px-2.5 py-1 rounded-md border border-studio-border"></span>
              <div id="drawer-card-tags" class="flex flex-wrap gap-1.5"></div>
            </div>

            <div class="rounded-xl border border-studio-border bg-studio-surface-subtle p-4 mb-4">
              <div class="text-[11px] font-mono text-studio-ink-muted uppercase tracking-wider mb-2 font-semibold">
                {t('hero.drawer.raw')}
              </div>
              <p id="drawer-card-excerpt" class="text-xs sm:text-[13px] text-studio-ink-soft leading-relaxed"></p>
            </div>

            <div class="rounded-xl bg-[#11182C] text-white p-3.5 border border-[#222F50] font-mono text-xs flex flex-col gap-1.5">
              <div class="flex items-center justify-between text-[11px] text-[#89AEFA]">
                <span class="font-semibold uppercase tracking-wider">{t('hero.drawer.mcp')}</span>
                <span class="text-[#849AC5]">read_resource</span>
              </div>
              <code id="drawer-card-mcp" class="text-[#E0ECFF] overflow-x-auto py-0.5"></code>
            </div>
          </div>

          <div class="px-5 py-3 bg-studio-surface-subtle border-t border-studio-border flex items-center justify-between text-xs text-studio-ink-muted">
            <span class="font-mono text-[11px]">IndexedDB: markshelf_snapshots_v1</span>
            <button
              type="button"
              id="drawer-footer-close"
              class="btn-secondary px-3.5 py-1 rounded-full text-xs font-medium cursor-pointer"
            >
              {t('hero.drawer.close')}
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Three Hardcore Technical Metrics (Oil Git & Oil Find style) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto mt-12 pt-8 border-t border-studio-border">
      <div class="flex flex-col">
        <div class="flex items-baseline gap-2 mb-1">
          <span class="font-mono text-2xl sm:text-3xl font-semibold tracking-tight text-studio-ink tabular-nums">
            {t('hero.metrics.num1')}
          </span>
          <span class="font-mono text-xs font-semibold text-brand-emerald tracking-wide">
            [OFFLINE]
          </span>
        </div>
        <h3 class="text-sm font-semibold text-studio-ink mb-1">
          {t('hero.metrics.label1')}
        </h3>
        <p class="text-xs sm:text-[13px] text-studio-ink-soft leading-relaxed">
          {t('hero.metrics.desc1')}
        </p>
      </div>

      <div class="flex flex-col">
        <div class="flex items-baseline gap-2 mb-1">
          <span class="font-mono text-2xl sm:text-3xl font-semibold tracking-tight text-studio-ink tabular-nums">
            {t('hero.metrics.num2')}
          </span>
          <span class="font-mono text-xs font-semibold text-brand-cobalt tracking-wide">
            [INSTANT]
          </span>
        </div>
        <h3 class="text-sm font-semibold text-studio-ink mb-1">
          {t('hero.metrics.label2')}
        </h3>
        <p class="text-xs sm:text-[13px] text-studio-ink-soft leading-relaxed">
          {t('hero.metrics.desc2')}
        </p>
      </div>

      <div class="flex flex-col">
        <div class="flex items-baseline gap-2 mb-1">
          <span class="font-mono text-2xl sm:text-3xl font-semibold tracking-tight text-studio-ink tabular-nums">
            {t('hero.metrics.num3')}
          </span>
          <span class="font-mono text-xs font-semibold text-brand-amber tracking-wide">
            [REVERSIBLE]
          </span>
        </div>
        <h3 class="text-sm font-semibold text-studio-ink mb-1">
          {t('hero.metrics.label3')}
        </h3>
        <p class="text-xs sm:text-[13px] text-studio-ink-soft leading-relaxed">
          {t('hero.metrics.desc3')}
        </p>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ lang, approveTemplate: t('drawer.diffApprove') }}>
  const tabBtns = document.querySelectorAll('.drawer-tab');
  const searchPanel = document.getElementById('panel-search');
  const diffPanel = document.getElementById('panel-diff');

  function activateTab(target) {
    closeCardDrawer();
    tabBtns.forEach((btn) => {
      const isMatch = btn.getAttribute('data-tab') === target;
      btn.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      btn.classList.toggle('is-active', isMatch);
      btn.classList.toggle('font-semibold', isMatch);
      btn.classList.toggle('text-studio-ink-soft', !isMatch);
    });
    searchPanel?.classList.toggle('hidden', target !== 'search');
    diffPanel?.classList.toggle('hidden', target !== 'diff');
  }

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activateTab(btn.getAttribute('data-tab') || 'search');
    });
  });

  const searchInput = document.getElementById('catalog-search-input');
  const cards = document.querySelectorAll('.catalog-sample-card');
  const emptyState = document.getElementById('catalog-empty-state');
  const cardsList = document.getElementById('catalog-cards-list');
  const quickChips = document.querySelectorAll('.quick-chip');
  const stageWindow = document.getElementById('stage-window');
  const snapshotDrawer = document.getElementById('snapshot-drawer');
  const drawerCloseBtn = document.getElementById('drawer-close-btn');
  const drawerFooterClose = document.getElementById('drawer-footer-close');
  const drawerTitle = document.getElementById('drawer-card-title');
  const drawerDomain = document.getElementById('drawer-card-domain');
  const drawerFolder = document.getElementById('drawer-card-folder');
  const drawerExcerpt = document.getElementById('drawer-card-excerpt');
  const drawerTags = document.getElementById('drawer-card-tags');
  const drawerMcp = document.getElementById('drawer-card-mcp');

  let selectedIdx = -1;

  function getVisibleCards() {
    return Array.from(cards).filter((c) => !c.classList.contains('hidden'));
  }

  function updateSelectedCard(newIndex) {
    const visibleCards = getVisibleCards();
    if (visibleCards.length === 0) {
      selectedIdx = -1;
      return;
    }
    cards.forEach((c) => c.classList.remove('is-selected'));
    if (newIndex < 0) newIndex = 0;
    if (newIndex >= visibleCards.length) newIndex = visibleCards.length - 1;
    selectedIdx = newIndex;
    const target = visibleCards[selectedIdx];
    if (target) {
      target.classList.add('is-selected');
      target.scrollIntoView({ block: 'nearest' });
    }
  }

  function openCardDrawer(cardEl) {
    if (!cardEl || !snapshotDrawer) return;
    const title = cardEl.getAttribute('data-orig-title') || cardEl.querySelector('h2')?.textContent || '';
    const domain = cardEl.getAttribute('data-domain') || '';
    const folder = cardEl.getAttribute('data-folder') || '';
    const excerpt = cardEl.getAttribute('data-orig-excerpt') || cardEl.querySelector('p')?.textContent || '';
    let tags = [];
    try {
      tags = JSON.parse(cardEl.getAttribute('data-tags') || '[]');
    } catch (_) {}

    if (drawerTitle) drawerTitle.textContent = title;
    if (drawerDomain) drawerDomain.textContent = domain;
    if (drawerFolder) drawerFolder.textContent = folder;
    if (drawerExcerpt) drawerExcerpt.textContent = excerpt;
    if (drawerTags) {
      drawerTags.innerHTML = tags
        .map(
          (t) =>
            `<span class="px-2 py-0.5 rounded-full text-[11px] font-mono bg-studio-bg border border-studio-border text-studio-ink-soft">#${t}</span>`
        )
        .join('');
    }
    if (drawerMcp) {
      drawerMcp.textContent = `markshelf get --uri "markshelf://snapshot/${domain}" --format markdown`;
    }

    snapshotDrawer.classList.remove('hidden');
    drawerCloseBtn?.focus();
  }

  function closeCardDrawer() {
    if (!snapshotDrawer || snapshotDrawer.classList.contains('hidden')) return;
    snapshotDrawer.classList.add('hidden');
    const visibleCards = getVisibleCards();
    if (selectedIdx >= 0 && visibleCards[selectedIdx]) {
      visibleCards[selectedIdx].focus();
    } else {
      searchInput?.focus();
    }
  }

  drawerCloseBtn?.addEventListener('click', closeCardDrawer);
  drawerFooterClose?.addEventListener('click', closeCardDrawer);

  cards.forEach((card) => {
    card.addEventListener('click', () => {
      const vCards = getVisibleCards();
      updateSelectedCard(vCards.indexOf(card));
      openCardDrawer(card);
    });
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        openCardDrawer(card);
      }
    });
  });

  // Store initial unhighlighted content
  cards.forEach((card) => {
    const titleEl = card.querySelector('h2');
    const descEl = card.querySelector('p');
    if (titleEl) card.setAttribute('data-orig-title', titleEl.textContent || '');
    if (descEl) card.setAttribute('data-orig-excerpt', descEl.textContent || '');
  });

  function escapeRegex(str) {
    return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  function highlightMatch(text, query) {
    if (!query) return text;
    const pattern = new RegExp(`(${escapeRegex(query)})`, 'gi');
    return text.replace(pattern, '<mark>$1</mark>');
  }

  function filterCards(rawQuery) {
    const q = (rawQuery || '').trim().toLowerCase().replace(/^#/, '');
    let visibleCount = 0;

    cards.forEach((card) => {
      const blob = card.getAttribute('data-search') || '';
      const matched = !q || blob.includes(q);
      card.classList.toggle('hidden', !matched);
      if (matched) {
        visibleCount++;
        const titleEl = card.querySelector('h2');
        const descEl = card.querySelector('p');
        const origTitle = card.getAttribute('data-orig-title') || '';
        const origExcerpt = card.getAttribute('data-orig-excerpt') || '';
        if (q) {
          if (titleEl) titleEl.innerHTML = highlightMatch(origTitle, q);
          if (descEl) descEl.innerHTML = highlightMatch(origExcerpt, q);
        } else {
          if (titleEl) titleEl.textContent = origTitle;
          if (descEl) descEl.textContent = origExcerpt;
        }
      }
    });

    cardsList?.classList.toggle('hidden', visibleCount === 0);
    emptyState?.classList.toggle('hidden', visibleCount > 0);

    quickChips.forEach((chip) => {
      const chipQ = (chip.getAttribute('data-quick-query') || '').toLowerCase();
      const active = chipQ === (rawQuery || '').trim().toLowerCase();
      chip.classList.toggle('bg-brand-indigo', active);
      chip.classList.toggle('text-white', active);
      chip.classList.toggle('bg-studio-bg', !active);
      chip.classList.toggle('text-studio-ink-soft', !active);
    });
    cardsList?.classList.toggle('hidden', visibleCount === 0);
    emptyState?.classList.toggle('hidden', visibleCount > 0);

    selectedIdx = -1;
    if (visibleCount > 0) {
      updateSelectedCard(0);
    }
  }

  searchInput?.addEventListener('input', (e) => {
    filterCards(e.target.value);
  });

  quickChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const val = chip.getAttribute('data-quick-query') || '';
      if (searchInput) searchInput.value = val;
      filterCards(val);
    });
  });

  // Minutes-style Keyboard shortcuts & Selection Navigation
  window.addEventListener('keydown', (e) => {
    const isSearchActive = !searchPanel?.classList.contains('hidden');
    const isDrawerOpen = snapshotDrawer && !snapshotDrawer.classList.contains('hidden');

    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      closeCardDrawer();
      activateTab('search');
      searchInput?.focus();
    } else if (e.key === 'Escape') {
      if (isDrawerOpen) {
        e.preventDefault();
        closeCardDrawer();
      } else if (document.activeElement === searchInput) {
        if (searchInput.value) {
          searchInput.value = '';
          filterCards('');
        } else {
          searchInput.blur();
        }
      }
    } else if (e.key === 'ArrowDown') {
      if (isSearchActive && !isDrawerOpen) {
        e.preventDefault();
        updateSelectedCard(selectedIdx + 1);
      }
    } else if (e.key === 'ArrowUp') {
      if (isSearchActive && !isDrawerOpen) {
        e.preventDefault();
        updateSelectedCard(selectedIdx - 1);
      }
    } else if (e.key === 'Enter' && document.activeElement !== searchInput) {
      if (isSearchActive && !isDrawerOpen) {
        const visible = getVisibleCards();
        if (selectedIdx >= 0 && visible[selectedIdx]) {
          e.preventDefault();
          openCardDrawer(visible[selectedIdx]);
        }
      }
    }
  });

  // Mobile Touch Swipe Handling (Sora style)
  let touchStartX = 0;
  let touchStartY = 0;

  stageWindow?.addEventListener(
    'touchstart',
    (e) => {
      touchStartX = e.changedTouches[0].screenX;
      touchStartY = e.changedTouches[0].screenY;
    },
    { passive: true }
  );

  stageWindow?.addEventListener(
    'touchend',
    (e) => {
      const dx = e.changedTouches[0].screenX - touchStartX;
      const dy = e.changedTouches[0].screenY - touchStartY;
      if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy)) {
        if (dx < 0) {
          activateTab('diff');
        } else {
          activateTab('search');
        }
      }
    },
    { passive: true }
  );

  const checkboxes = document.querySelectorAll('.diff-checkbox');
  const approveBtn = document.getElementById('diff-approve-btn');
  const undoBtn = document.getElementById('diff-undo-btn');
  const statusPill = document.getElementById('diff-status-pill');

  function updateApproveCount() {
    if (!approveBtn) return;
    const count = Array.from(checkboxes).filter((cb) => cb.checked).length;
    approveBtn.textContent = approveTemplate.replace(/\d+/, String(count));
    approveBtn.toggleAttribute('disabled', count === 0);
    approveBtn.classList.toggle('opacity-50', count === 0);
  }

  checkboxes.forEach((cb) => cb.addEventListener('change', updateApproveCount));

  approveBtn?.addEventListener('click', () => {
    statusPill?.classList.remove('hidden');
    undoBtn?.classList.remove('hidden');
    approveBtn.classList.add('hidden');
  });

  undoBtn?.addEventListener('click', () => {
    statusPill?.classList.add('hidden');
    undoBtn.classList.add('hidden');
    approveBtn?.classList.remove('hidden');
  });
</script>
