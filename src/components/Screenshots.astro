---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import type { Language } from '../i18n/ui';
import { useTranslation } from '../i18n/utils';

import homeImg from '../assets/screenshots/home.png';
import organizeImg from '../assets/screenshots/orangize.png';
import exportImg from '../assets/screenshots/export.png';
import healthcheckImg from '../assets/screenshots/healthcheck.png';
import settingsProviderImg from '../assets/screenshots/settings-provider.png';
import settingsSkillsImg from '../assets/screenshots/settings-skills.png';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslation(lang);

const screenshots = [
  { id: 'home', src: homeImg, tab: lang === 'zh' ? '书架视图' : 'Shelf', caption: t('screenshots.home') },
  { id: 'organize', src: organizeImg, tab: lang === 'zh' ? 'Diff 整理' : 'Diff Review', caption: t('screenshots.organize') },
  { id: 'healthcheck', src: healthcheckImg, tab: lang === 'zh' ? '健康检查' : 'Health Check', caption: t('screenshots.healthcheck') },
  { id: 'export', src: exportImg, tab: lang === 'zh' ? '备份导出' : 'Backup', caption: t('screenshots.export') },
  { id: 'provider', src: settingsProviderImg, tab: lang === 'zh' ? 'AI 服务商' : 'Providers', caption: t('screenshots.settings-provider') },
  { id: 'skills', src: settingsSkillsImg, tab: lang === 'zh' ? '提示词技能' : 'Skills', caption: t('screenshots.settings-skills') },
];
---

<section id="screenshots" class="py-16 sm:py-24 bg-studio-surface border-y border-studio-border">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
      <div>
        <h2 class="text-2xl sm:text-4xl font-semibold tracking-[-0.03em] text-studio-ink mb-2">
          {t('screenshots.title')}
        </h2>
        <p class="text-base text-studio-ink-soft">
          {t('screenshots.subtitle')}
        </p>
      </div>

      <!-- Segmented Pill Switcher -->
      <div class="flex items-center gap-2 flex-wrap">
        <div class="seg-pill inline-flex items-center overflow-x-auto max-w-full" role="tablist" aria-label={t('screenshots.title')}>
          {screenshots.map((shot, idx) => (
            <button
              type="button"
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
              class:list={[
                'shot-tab seg-btn px-3 py-1.5 text-xs font-medium whitespace-nowrap cursor-pointer',
                idx === 0
                  ? 'is-active font-semibold text-studio-ink'
                  : 'text-studio-ink-soft hover:text-studio-ink',
              ]}
              data-shot-index={idx}
            >
              {shot.tab}
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Clean Window Frame (exact 3024:1646 ratio so zero cropping occurs) -->
    <div class="studio-window overflow-hidden">
      <div id="carousel-track" class="flex transition-transform duration-300 ease-out">
        {screenshots.map((shot) => (
          <div class="w-full shrink-0">
            <button
              type="button"
              class="block w-full text-left cursor-zoom-in bg-studio-surface"
              data-lightbox-trigger
              aria-label={shot.caption}
            >
              <Image
                src={shot.src}
                alt={shot.caption}
                class="w-full aspect-[3024/1646] object-contain bg-white"
                loading="lazy"
              />
            </button>
          </div>
        ))}
      </div>

      <div class="px-4 sm:px-5 py-3 border-t border-studio-border bg-studio-surface-subtle flex items-center justify-between gap-4">
        <p id="shot-caption" class="text-xs sm:text-sm text-studio-ink font-medium truncate">
          {screenshots[0].caption}
        </p>
        <div class="flex items-center gap-2 shrink-0">
          <span class="font-mono text-xs text-studio-ink-muted tabular-nums mr-1" id="shot-counter">
            1 / {screenshots.length}
          </span>
          <button
            id="prev-btn"
            type="button"
            class="btn-secondary w-8 h-8 rounded-full flex items-center justify-center cursor-pointer"
            aria-label={lang === 'zh' ? '上一张截图' : 'Previous screenshot'}
          >
            <Icon name="heroicons:chevron-left" class="w-4 h-4" />
          </button>
          <button
            id="next-btn"
            type="button"
            class="btn-secondary w-8 h-8 rounded-full flex items-center justify-center cursor-pointer"
            aria-label={lang === 'zh' ? '下一张截图' : 'Next screenshot'}
          >
            <Icon name="heroicons:chevron-right" class="w-4 h-4" />
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Lightbox -->
  <div id="lightbox" class="lightbox-overlay" role="dialog" aria-modal="true" aria-label={t('screenshots.title')}>
    <button
      id="lightbox-close"
      type="button"
      class="absolute top-5 right-5 w-10 h-10 rounded-full bg-white/10 border border-white/20 text-white hover:bg-white/20 flex items-center justify-center cursor-pointer transition-colors"
      aria-label={lang === 'zh' ? '关闭预览' : 'Close preview'}
    >
      <Icon name="heroicons:x-mark" class="w-5 h-5" />
    </button>
    <div id="lightbox-frame"></div>
  </div>
</section>

<script define:vars={{ captions: screenshots.map((s) => s.caption) }}>
  const track = document.getElementById('carousel-track');
  const prevBtn = document.getElementById('prev-btn');
  const nextBtn = document.getElementById('next-btn');
  const shotTabs = document.querySelectorAll('.shot-tab');
  const captionEl = document.getElementById('shot-caption');
  const counterEl = document.getElementById('shot-counter');
  const total = captions.length;
  let currentIndex = 0;

  function goToSlide(idx) {
    currentIndex = ((idx % total) + total) % total;
    if (track) track.style.transform = `translateX(-${currentIndex * 100}%)`;
    if (captionEl) captionEl.textContent = captions[currentIndex];
    if (counterEl) counterEl.textContent = `${currentIndex + 1} / ${total}`;

    shotTabs.forEach((tab, i) => {
      const active = i === currentIndex;
      tab.setAttribute('aria-selected', String(active));
      tab.classList.toggle('is-active', active);
      tab.classList.toggle('font-semibold', active);
      tab.classList.toggle('text-studio-ink-soft', !active);
    });
  }

  prevBtn?.addEventListener('click', () => goToSlide(currentIndex - 1));
  nextBtn?.addEventListener('click', () => goToSlide(currentIndex + 1));
  shotTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const idx = Number(tab.getAttribute('data-shot-index') || 0);
      goToSlide(idx);
    });
  });

  const lightbox = document.getElementById('lightbox');
  const lightboxFrame = document.getElementById('lightbox-frame');
  const lightboxClose = document.getElementById('lightbox-close');

  document.querySelectorAll('[data-lightbox-trigger]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const img = btn.querySelector('img');
      if (img && lightboxFrame && lightbox) {
        const clone = document.createElement('img');
        clone.src = img.currentSrc || img.src;
        clone.alt = img.alt;
        lightboxFrame.replaceChildren(clone);
        lightbox.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  function closeLightbox() {
    lightbox?.classList.remove('active');
    lightboxFrame?.replaceChildren();
    document.body.style.overflow = '';
  }

  lightboxClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox?.classList.contains('active')) closeLightbox();
  });
</script>
