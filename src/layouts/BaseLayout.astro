---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import type { Language } from '../i18n/ui';
import { getLocalizedPath, useTranslation } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  lang: Language;
  currentPath?: string;
}

const { title, description, lang, currentPath = '/' } = Astro.props;
const canonicalPath = getLocalizedPath(lang, currentPath);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const t = useTranslation(lang);

const ogLocales: Record<Language, string> = {
  en: 'en_US',
  zh: 'zh_CN',
  'zh-tw': 'zh_TW',
  ru: 'ru_RU',
  ja: 'ja_JP',
  de: 'de_DE',
  es: 'es_ES',
  fr: 'fr_FR',
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#F3F6FA" />
    <meta name="google-site-verification" content="hylPpzj7GILGH_jW-ZzdIvrRH4G4q0hgGL_TM1Rxh_Y" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />

    <!-- SEO -->
    <title>{title}</title>
    <link rel="canonical" href={`${Astro.site}${base}${canonicalPath}`} />
    <link rel="alternate" hreflang="en" href={`${Astro.site}${base}${getLocalizedPath('en', currentPath)}`} />
    <link rel="alternate" hreflang="zh" href={`${Astro.site}${base}${getLocalizedPath('zh', currentPath)}`} />
    <link rel="alternate" hreflang="zh-TW" href={`${Astro.site}${base}${getLocalizedPath('zh-tw', currentPath)}`} />
    <link rel="alternate" hreflang="ru" href={`${Astro.site}${base}${getLocalizedPath('ru', currentPath)}`} />
    <link rel="alternate" hreflang="ja" href={`${Astro.site}${base}${getLocalizedPath('ja', currentPath)}`} />
    <link rel="alternate" hreflang="de" href={`${Astro.site}${base}${getLocalizedPath('de', currentPath)}`} />
    <link rel="alternate" hreflang="es" href={`${Astro.site}${base}${getLocalizedPath('es', currentPath)}`} />
    <link rel="alternate" hreflang="fr" href={`${Astro.site}${base}${getLocalizedPath('fr', currentPath)}`} />
    <link rel="alternate" hreflang="x-default" href={`${Astro.site}${base}${getLocalizedPath('en', currentPath)}`} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${Astro.site}${base}/logo.png`} />
    <meta property="og:locale" content={ogLocales[lang] || 'en_US'} />
  </head>
  <body class="min-h-screen flex flex-col bg-studio-bg text-studio-ink antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[120] focus:px-4 focus:py-2 focus:rounded-full focus:bg-studio-surface focus:text-studio-ink focus:border focus:border-studio-border-strong focus:shadow-lg"
    >
      {t('nav.skipToContent')}
    </a>

    <Navbar lang={lang} currentPath={currentPath} />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>
