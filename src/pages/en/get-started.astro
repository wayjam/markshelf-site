---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslation } from '../../i18n/utils';
import { config } from '../../config';

const lang = 'en';
const t = useTranslation(lang);

const isAvailable = (url: string) => !!url && url !== '#';

const browsers = [
  {
    key: 'chrome' as const,
    name: t('getStarted.chrome.title'),
    href: config.stores.chrome,
    icon: 'simple-icons:googlechrome',
    iconColor: '#1A73E8',
  },
  {
    key: 'firefox' as const,
    name: t('getStarted.firefox.title'),
    href: config.stores.firefox,
    icon: 'simple-icons:firefox',
    iconColor: '#E66000',
  },
  {
    key: 'edge' as const,
    name: t('getStarted.edge.title'),
    href: config.stores.edge,
    icon: 'simple-icons:microsoftedge',
    iconColor: '#0078D4',
  },
].map((b) => ({
  ...b,
  available: isAvailable(b.href),
  desc: isAvailable(b.href)
    ? t(`getStarted.${b.key}.desc`)
    : t('getStarted.comingSoonDesc'),
  cta: isAvailable(b.href)
    ? t(`getStarted.${b.key}.cta`)
    : t('getStarted.comingSoon'),
}));

const onboardingSteps = [
  { title: t('getStarted.step1.title'), desc: t('getStarted.step1.desc') },
  { title: t('getStarted.step2.title'), desc: t('getStarted.step2.desc') },
  { title: t('getStarted.step3.title'), desc: t('getStarted.step3.desc') },
];
---

<BaseLayout
  title="Install MarkShelf — Get Started"
  description="Install MarkShelf on Chrome, Firefox, or Edge"
  lang="en"
  currentPath="/get-started/"
>
  <section class="py-14 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12">
        <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-0.03em] text-studio-ink mb-3">
          {t('getStarted.title')}
        </h1>
        <p class="text-base sm:text-lg text-studio-ink-soft leading-relaxed">
          {t('getStarted.subtitle')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        {browsers.map((browser) => (
          <div class="studio-card p-6 flex flex-col">
            <div class="w-11 h-11 rounded-xl bg-studio-bg border border-studio-border flex items-center justify-center mb-5">
              <Icon name={browser.icon} class="w-6 h-6" style={`color: ${browser.iconColor}`} />
            </div>
            <h2 class="text-lg font-semibold tracking-[-0.02em] text-studio-ink mb-2">
              {browser.name}
            </h2>
            <p class="text-sm text-studio-ink-soft leading-relaxed mb-6 flex-1">
              {browser.desc}
            </p>
            {browser.available ? (
              <a
                href={browser.href}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-full text-sm font-semibold"
              >
                <span>{browser.cta}</span>
                <Icon name="heroicons:arrow-top-right-on-square" class="w-4 h-4" />
              </a>
            ) : (
              <div class="inline-flex items-center justify-center px-4 py-2.5 rounded-full bg-studio-bg border border-studio-border text-studio-ink-muted text-sm font-medium">
                {browser.cta}
              </div>
            )}
          </div>
        ))}
      </div>

      <div class="studio-card p-6 sm:p-8 mb-8">
        <h2 class="text-lg font-semibold tracking-[-0.02em] text-studio-ink mb-6 pb-3.5 border-b border-studio-border">
          {t('getStarted.stepsTitle')}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {onboardingSteps.map((step, i) => (
            <div>
              <div class="font-mono text-xs text-brand-cobalt font-semibold mb-1.5 tabular-nums">
                Step {i + 1}
              </div>
              <h3 class="text-sm font-semibold text-studio-ink mb-1.5">
                {step.title}
              </h3>
              <p class="text-sm text-studio-ink-soft leading-relaxed">
                {step.desc}
              </p>
            </div>
          ))}
        </div>
      </div>

      <div class="rounded-2xl bg-[#192444] text-white p-6 sm:p-8 border border-[#2C3B69]">
        <div class="max-w-2xl mb-6">
          <h2 class="text-lg sm:text-xl font-semibold tracking-[-0.02em] text-white mb-1.5">
            {t('getStarted.agentTitle')}
          </h2>
          <p class="text-sm text-[#C8D4EE] leading-relaxed">
            {t('getStarted.agentSubtitle')}
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-5">
          <div class="rounded-xl bg-white/[0.06] border border-white/10 p-4">
            <h3 class="text-sm font-semibold text-white mb-1">{t('getStarted.agentStep1.title')}</h3>
            <p class="text-xs sm:text-[13px] text-[#C8D4EE] leading-relaxed">{t('getStarted.agentStep1.desc')}</p>
          </div>
          <div class="rounded-xl bg-white/[0.06] border border-white/10 p-4">
            <h3 class="text-sm font-semibold text-white mb-1">{t('getStarted.agentStep2.title')}</h3>
            <p class="text-xs sm:text-[13px] text-[#C8D4EE] leading-relaxed">{t('getStarted.agentStep2.desc')}</p>
          </div>
        </div>
        <div class="space-y-2 text-xs sm:text-[13px] text-[#CFE0FF] leading-relaxed border-t border-white/10 pt-4">
          <p>{t('getStarted.agentWayA')}</p>
          <p>{t('getStarted.agentWayB')}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
