---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslation } from '../../i18n/utils';
import { config } from '../../config';

const lang = 'en';
const t = useTranslation(lang);

const isAvailable = (url: string) => !!url && url !== '#';

const browsers = [
  {
    key: 'chrome' as const,
    name: t('getStarted.chrome.title'),
    href: config.stores.chrome,
    icon: 'simple-icons:googlechrome',
    iconColor: '#1A73E8',
  },
  {
    key: 'firefox' as const,
    name: t('getStarted.firefox.title'),
    href: config.stores.firefox,
    icon: 'simple-icons:firefox',
    iconColor: '#E66000',
  },
  {
    key: 'edge' as const,
    name: t('getStarted.edge.title'),
    href: config.stores.edge,
    icon: 'simple-icons:microsoftedge',
    iconColor: '#0078D4',
  },
].map((b) => ({
  ...b,
  available: isAvailable(b.href),
  desc: isAvailable(b.href)
    ? t(`getStarted.${b.key}.desc`)
    : t('getStarted.comingSoonDesc'),
  cta: isAvailable(b.href)
    ? t(`getStarted.${b.key}.cta`)
    : t('getStarted.comingSoon'),
}));

const onboardingSteps = [
  { title: t('getStarted.step1.title'), desc: t('getStarted.step1.desc') },
  { title: t('getStarted.step2.title'), desc: t('getStarted.step2.desc') },
  { title: t('getStarted.step3.title'), desc: t('getStarted.step3.desc') },
];
---

<BaseLayout
  title="Install MarkShelf — Get Started"
  description="Install MarkShelf on Chrome, Firefox, or Edge"
  lang="en"
  currentPath="/get-started/"
>
  <section class="py-14 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-studio-border bg-studio-surface text-xs font-mono font-medium text-studio-ink-soft mb-4 shadow-2xs">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-emerald"></span>
          <span>{t('getStarted.badge')}</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-0.03em] text-studio-ink mb-3">
          {t('getStarted.title')}
        </h1>
        <p class="text-base sm:text-lg text-studio-ink-soft leading-relaxed">
          {t('getStarted.subtitle')}
        </p>
      </div>

      <!-- Browser Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        {browsers.map((browser) => (
          <div class="studio-card p-6 flex flex-col justify-between hover:border-studio-border-strong transition-all duration-200">
            <div>
              <div class="flex items-center justify-between mb-5">
                <div class="w-12 h-12 rounded-xl bg-studio-surface-subtle border border-studio-border flex items-center justify-center shadow-2xs">
                  <Icon name={browser.icon} class="w-6 h-6" style={`color: ${browser.iconColor}`} />
                </div>
                {browser.available ? (
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#ECFDF3] border border-[#BBF7D0] text-[11px] font-mono text-brand-emerald font-medium">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand-emerald"></span>
                    {t('getStarted.ready')}
                  </span>
                ) : (
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-studio-bg border border-studio-border text-[11px] font-mono text-studio-ink-muted">
                    {t('getStarted.comingSoon')}
                  </span>
                )}
              </div>
              <h2 class="text-lg font-semibold tracking-[-0.02em] text-studio-ink mb-2">
                {browser.name}
              </h2>
              <p class="text-xs sm:text-[13px] text-studio-ink-soft leading-relaxed mb-6">
                {browser.desc}
              </p>
            </div>
            <div>
              {browser.available ? (
                <a
                  href={browser.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-primary w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold cursor-pointer"
                >
                  <span>{browser.cta}</span>
                  <Icon name="heroicons:arrow-top-right-on-square" class="w-4 h-4" />
                </a>
              ) : (
                <div class="w-full inline-flex items-center justify-center px-4 py-2.5 rounded-xl bg-studio-surface-subtle border border-dashed border-studio-border text-studio-ink-muted text-xs font-mono font-medium">
                  {browser.cta}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- First 60s Onboarding Timeline -->
      <div class="studio-card p-6 sm:p-8 mb-10">
        <div class="flex items-center justify-between mb-6 pb-4 border-b border-studio-border">
          <div>
            <h2 class="text-lg font-semibold tracking-[-0.02em] text-studio-ink mb-1">
              {t('getStarted.stepsTitle')}
            </h2>
            <p class="text-xs sm:text-[13px] text-studio-ink-muted">
              {t('getStarted.onboardingSub')}
            </p>
          </div>
          <span class="font-mono text-xs text-studio-ink-muted bg-studio-surface-subtle border border-studio-border px-2.5 py-1 rounded-md hidden sm:inline-block">
            60s Onboarding
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {onboardingSteps.map((step, i) => (
            <div class="p-5 rounded-xl bg-studio-surface-subtle border border-studio-border flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="font-mono text-xs font-semibold text-brand-cobalt bg-studio-surface px-2.5 py-0.5 rounded border border-studio-border">
                    0{i + 1}
                  </span>
                  <span class="text-[11px] font-mono text-studio-ink-muted">STEP 0{i + 1}</span>
                </div>
                <h3 class="text-sm font-semibold text-studio-ink mb-2">
                  {step.title}
                </h3>
                <p class="text-xs sm:text-[13px] text-studio-ink-soft leading-relaxed">
                  {step.desc}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Advanced Agent Bridge Deep Card -->
      <div class="rounded-2xl bg-[#192444] text-white p-6 sm:p-8 border border-[#2C3B69] shadow-[0_20px_50px_-15px_rgba(25,36,68,0.35)]">
        <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 mb-6">
          <div class="max-w-2xl">
            <div class="flex items-center gap-2 mb-2">
              <span class="w-2 h-2 rounded-full bg-brand-emerald"></span>
              <span class="font-mono text-[11px] uppercase tracking-wider text-[#89AEFA] font-medium">Native Messaging · Stdio MCP</span>
            </div>
            <h2 class="text-lg sm:text-2xl font-semibold tracking-[-0.02em] text-white mb-2">
              {t('getStarted.agentTitle')}
            </h2>
            <p class="text-xs sm:text-[13px] text-[#C8D4EE] leading-relaxed">
              {t('getStarted.agentSubtitle')}
            </p>
          </div>
          <span class="font-mono text-xs text-[#89AEFA] bg-white/[0.08] border border-white/10 px-3 py-1 rounded-full shrink-0">
            [LOCAL BRIDGE]
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
          <div class="rounded-xl bg-white/[0.06] border border-white/10 p-5 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="font-mono text-xs text-[#89AEFA] font-medium">STEP 1</span>
              </div>
              <h3 class="text-sm font-semibold text-white mb-1.5">{t('getStarted.agentStep1.title')}</h3>
              <p class="text-xs sm:text-[13px] text-[#C8D4EE] leading-relaxed mb-3">{t('getStarted.agentStep1.desc')}</p>
            </div>
            <div class="px-3 py-2 rounded-lg bg-black/40 border border-white/10 font-mono text-[11px] text-[#A5C0EE]">
              <code>chrome://extensions/?id=...</code>
            </div>
          </div>

          <div class="rounded-xl bg-white/[0.06] border border-white/10 p-5 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="font-mono text-xs text-[#89AEFA] font-medium">STEP 2</span>
              </div>
              <h3 class="text-sm font-semibold text-white mb-1.5">{t('getStarted.agentStep2.title')}</h3>
              <p class="text-xs sm:text-[13px] text-[#C8D4EE] leading-relaxed mb-3">{t('getStarted.agentStep2.desc')}</p>
            </div>
            <div class="px-3 py-2 rounded-lg bg-black/40 border border-white/10 font-mono text-[11px] text-[#A5C0EE] flex items-center justify-between gap-2 overflow-x-auto">
              <code>npx @markshelf/companion install --ext-id &lt;EXTENSION_ID&gt;</code>
              <button
                type="button"
                id="copy-companion-btn"
                class="copy-terminal-btn text-[11px] uppercase text-[#89AEFA] hover:text-white shrink-0 font-sans font-medium px-2 py-0.5 rounded bg-white/10 cursor-pointer transition-colors"
                data-copy="npx @markshelf/companion install --ext-id <EXTENSION_ID>"
              >
                {t('getStarted.terminalCopy')}
              </button>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 border-t border-white/10 pt-5">
          <div class="rounded-xl bg-white/[0.03] border border-white/10 p-4">
            <div class="font-mono text-[11px] text-[#89AEFA] font-medium mb-1.5 uppercase">
              {t('getStarted.wayA.label')}
            </div>
            <p class="text-xs sm:text-[13px] text-[#CFE0FF] leading-relaxed mb-2.5">
              {t('getStarted.agentWayA')}
            </p>
            <div class="px-3 py-1.5 rounded-lg bg-black/30 border border-white/10 font-mono text-[11px] text-[#89AEFA]">
              <code>markshelf search "local-first" --snapshot</code>
            </div>
          </div>

          <div class="rounded-xl bg-white/[0.03] border border-white/10 p-4">
            <div class="font-mono text-[11px] text-[#89AEFA] font-medium mb-1.5 uppercase">
              {t('getStarted.wayB.label')}
            </div>
            <p class="text-xs sm:text-[13px] text-[#CFE0FF] leading-relaxed mb-2.5">
              {t('getStarted.agentWayB')}
            </p>
            <div class="px-3 py-1.5 rounded-lg bg-black/30 border border-white/10 font-mono text-[11px] text-[#89AEFA] flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-emerald"></span>
              <span>claude · codex · gemini · omp</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const copyBtn = document.getElementById('copy-companion-btn');
    copyBtn?.addEventListener('click', async () => {
      const text = copyBtn.getAttribute('data-copy') || '';
      try {
        await navigator.clipboard.writeText(text);
        const orig = copyBtn.textContent;
        copyBtn.textContent = '✓';
        setTimeout(() => {
          copyBtn.textContent = orig;
        }, 1800);
      } catch (_) {}
    });
  </script>
</BaseLayout>
